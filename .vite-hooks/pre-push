#!/usr/bin/env sh
# push 前の検査。CI と同じ順で、速いものから走らせる。
#   1. vp check          format + 型情報つき lint + 型チェック
#   2. vp run -r test    Unit / Integration
#   3. AI コードレビュー  CI と同じスキル(codereview-on-ci)をローカルモードで実行。Must があれば push を止める
#
# 飛ばし方:
#   git push --no-verify            すべて飛ばす(CI 側は必ず走る)
#   PONMOJI_SKIP_AI_REVIEW=1 git push   AI レビューだけ飛ばす
#   VP_GIT_HOOKS=0 git push         Vite+ のフックをすべて飛ばす
set -eu

cd "$(git rev-parse --show-toplevel)"
BASE_BRANCH="${PONMOJI_REVIEW_BASE:-main}"
BASE_REF="origin/$BASE_BRANCH"
STATE_DIR=".codereview-on-ci"
VERDICT="$STATE_DIR/local-verdict.json"
LAST="$STATE_DIR/last-reviewed-sha"

# push 先が無い・ベースが取れない場合は検査せず通す(CI に任せる)
git rev-parse --verify -q "$BASE_REF" >/dev/null || { echo "pre-push: $BASE_REF が無いので検査を飛ばします"; exit 0; }

# stdin には push される ref が 1 行ずつ来る: <local ref> <local sha> <remote ref> <remote sha>
# 削除だけ(local sha が全部 0)や、HEAD 以外のブランチだけを push するときは検査しない。
# 手動実行(stdin が空)のときは HEAD を push するものとして扱う
HEAD_SHA="$(git rev-parse HEAD)"
ZERO="0000000000000000000000000000000000000000"
PUSHES_HEAD=0
HAS_LINE=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "$local_sha" ] || continue
  HAS_LINE=1
  [ "$local_sha" = "$ZERO" ] && continue
  [ "$local_sha" = "$HEAD_SHA" ] && PUSHES_HEAD=1
done
if [ "$HAS_LINE" = 1 ] && [ "$PUSHES_HEAD" = 0 ]; then
  echo "pre-push: HEAD 以外の ref の push(削除やタグ)なので検査を飛ばします"
  exit 0
fi

if git diff --quiet "$BASE_REF...HEAD"; then
  echo "pre-push: $BASE_BRANCH との差分が無いので検査を飛ばします"
  exit 0
fi

echo "▶ pre-push 1/3: vp check"
pnpm exec vp check

echo "▶ pre-push 2/3: vp run -r test"
pnpm exec vp run -r test

if [ "${PONMOJI_SKIP_AI_REVIEW:-0}" = "1" ]; then
  echo "pre-push 3/3: PONMOJI_SKIP_AI_REVIEW=1 のため AI レビューを飛ばします"
  exit 0
fi

# 文書と画像だけの差分なら飛ばす(.claude/ 配下の md はレビュー基準そのものなので対象に含める)
if ! git diff --name-only "$BASE_REF...HEAD" | grep -Ev '^(docs/|README)|\.(md|mdx|txt|png|jpe?g|gif|webp|svg|ico)$' | grep -q . \
   && ! git diff --name-only "$BASE_REF...HEAD" | grep -q '^\.claude/'; then
  echo "pre-push 3/3: 文書・画像だけの差分なので AI レビューを飛ばします"
  exit 0
fi

if [ -f "$LAST" ] && [ "$(cat "$LAST")" = "$HEAD_SHA" ]; then
  echo "pre-push 3/3: $HEAD_SHA は Must 0 件でレビュー済みのため飛ばします"
  exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "pre-push 3/3: claude コマンドが無いため AI レビューを飛ばします(CI で実行されます)"
  exit 0
fi

echo "▶ pre-push 3/3: AI コードレビュー($BASE_BRANCH...HEAD)。数分かかります(実測 2〜5 分)"
mkdir -p "$STATE_DIR"
rm -f "$VERDICT"

# stdin には push される ref の一覧が来るので、claude に渡さない
claude -p "/codereview-on-ci --local BASE_BRANCH=$BASE_BRANCH" \
  --output-format text \
  --max-turns 60 \
  --allowedTools "Read,Grep,Glob,Write,Bash(git diff:*),Bash(git log:*),Bash(git blame:*),Bash(git grep:*),Bash(git show:*),Bash(git rev-parse:*)" \
  < /dev/null || { echo "pre-push: AI レビューの実行に失敗しました。--no-verify で回避できます"; exit 1; }

if [ ! -f "$VERDICT" ]; then
  echo "pre-push: 判定ファイル($VERDICT)が書かれませんでした。--no-verify で回避できます"
  exit 1
fi

# 判定ファイルを検証する。壊れている・HEAD と一致しない場合は安全側(push を止める)
PARSED="$(node -e '
  const v = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
  if (!Number.isInteger(v.must) || !Number.isInteger(v.nit) || typeof v.head !== "string") throw new Error("形式が不正");
  process.stdout.write(`${v.must} ${v.nit} ${v.head}`);
' "$PWD/$VERDICT" 2>/dev/null)" || { echo "pre-push: 判定ファイル($VERDICT)を読めませんでした。--no-verify で回避できます"; exit 1; }
MUST="${PARSED%% *}"
REST="${PARSED#* }"
NIT="${REST%% *}"
VERDICT_HEAD="${REST#* }"
if [ "$VERDICT_HEAD" != "$HEAD_SHA" ]; then
  echo "pre-push: 判定ファイルの head($VERDICT_HEAD)が HEAD($HEAD_SHA)と一致しません。--no-verify で回避できます"
  exit 1
fi

if [ "$MUST" -gt 0 ]; then
  echo ""
  echo "✖ pre-push: 🚨 Must $MUST 件 / 💭 Nit $NIT 件。Must を直してから push してください"
  exit 1
fi

printf '%s' "$HEAD_SHA" > "$LAST"
echo "✔ pre-push: 🚨 Must 0 件 / 💭 Nit $NIT 件"
